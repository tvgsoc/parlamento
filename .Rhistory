plot = FALSE # create plots?
gexf = FALSE # download photos
mode = "fruchtermanreingold"
meta = c(
"cty" = "Italy",
"lang" = "it", # Wikipedia language for chamber and constituencies
"ca" = "Camera dei Deputati",
"se" = "Senato della Repubblica",
"type-ca" = "Lower",
"type-se" = "Upper",
